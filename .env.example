# ──────────────────────────────────────────────
# Policy Search Backend — environment template
# Copy to .env and fill with real values.
# NEVER commit .env — only this template.
# ──────────────────────────────────────────────

# PostgreSQL (issue #2+)
# DATABASE_URL=postgresql://user:password@localhost:5432/policy_search
POSTGRES_PASSWORD=policy

# CORS (issue #21) — empty by default: the web tier proxies API calls
# server-side, so browsers never call the API cross-origin. Set explicit
# origins only if a browser client must call the API directly.
# CORS_ORIGINS=https://policy.example.com

# API hardening (issue #21)
# RATE_LIMIT_PER_MINUTE=60
# MAX_REQUEST_BODY_BYTES=1048576

# GitHub archive repository (issue #13+)
# GITHUB_TOKEN=
# ARCHIVE_REPO=cameleonh/policy-search-archive

# LLM provider (issue #15+)
# LLM_API_KEY=
